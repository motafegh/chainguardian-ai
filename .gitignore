# ============================================================================
# CHAINGUARDIAN AI - .gitignore
# ============================================================================
# Last Updated: 2025-12-21
# Optimized for project structure with external datasets and large artifacts
# ============================================================================


# ============================================================================
# PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
# Secrets
.env
.env.local
railway.env

# CI/CD
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Railway
.railway/

# Virtual environments
venv/
.venv/
ENV/
env/
.virtualenv/


# ============================================================================
# TESTING & CODE QUALITY
# ============================================================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/


# ============================================================================
# DEPENDENCY MANAGEMENT
# ============================================================================
# Poetry: Keep poetry.lock tracked for reproducibility


# ============================================================================
# DEVELOPMENT ENVIRONMENT
# ============================================================================
# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
**/.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
*.bak
*.tmp


# ============================================================================
# ENVIRONMENT & SECRETS (CRITICAL)
# ============================================================================
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
service-account.json
secrets/
.secrets/


# ============================================================================
# DATA FILES - PROJECT SPECIFIC
# ============================================================================
# External datasets (large, can be re-downloaded)
data/safe_contracts/openzeppelin-contracts/**
!data/safe_contracts/openzeppelin-contracts/README.md
!data/safe_contracts/openzeppelin-contracts/LICENSE

data/smartbugs_curated/dataset/**/*.sol
# Keep smartbugs metadata
!data/smartbugs_curated/vulnerabilities.json
!data/smartbugs_curated/versions.csv
!data/smartbugs_curated/README.md

data/vulnerable_complex/defi_hacks/**
data/vulnerable_complex/etherscan_exploits/**
data/vulnerable_complex/rekt_news/**
!data/vulnerable_complex/rekt_news/rekt_metadata.json
data/vulnerable_complex/slowmist_hacked/**
data/vulnerable_complex/swc_registry/entries/**
data/vulnerable_complex/trail_of_bits/**/*.sol
!data/vulnerable_complex/trail_of_bits/README.md
!data/vulnerable_complex/trail_of_bits/LICENSE

# Raw contract sources (regenerable)
data/production/safe/raw/**
data/production/vulnerable/raw/**

# Keep metadata and processed data
!data/production/*/metadata/**

# Large temporary CSVs (if any get too big, uncomment)
# data/*_full.csv
# data/*_unlabeled*.csv

# Scraping checkpoints (regenerable)
data/scraping_checkpoint.json
data/collection_log.csv


# ============================================================================
# SMART CONTRACTS (Solidity files in datasets)
# ============================================================================
# Ignore all .sol files in data directories
data/**/*.sol

# Keep example contracts for documentation
!test_contracts/examples/*.sol
!docs/examples/**/*.sol

# Slither/Mythril artifacts
crytic-export/
.solc-select/
slither_report.txt


# ============================================================================
# ML MODELS & ARTIFACTS
# ============================================================================
# Model binaries (too large for Git)
models/**/*.pkl
models/**/*.joblib
models/**/*.h5
models/**/*.pt
models/**/*.pth
models/**/*.onnx

# Keep configs and documentation
!models/**/.gitkeep
!models/**/config.json
!models/**/metadata.json
!models/**/README.md
!models/**/MODEL_CARD.md
!models/**/PRODUCTION_MODEL_README.json


# ============================================================================
# MLOPS & EXPERIMENT TRACKING
# ============================================================================
# MLflow
mlruns/
mlflow.db
.mlflow/

# Weights & Biases
wandb/

# TensorBoard
runs/
events.out.tfevents.*


# ============================================================================
# DATABASES
# ============================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
airflow.db
chainguardian.db


# ============================================================================
# LOGS
# ============================================================================
logs/
*.log
*.log.*
*.out


# ============================================================================
# AIRFLOW
# ============================================================================
airflow/logs/
airflow/*.pid
airflow/*.db
airflow/*.cfg.local


# ============================================================================
# INFRASTRUCTURE
# ============================================================================
# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup

# Kubernetes secrets
k8s/secrets/


# ============================================================================
# DOCUMENTATION DRAFTS
# ============================================================================
Full_RoadMap.md
**/DRAFT_*.md
**/*_OLD.md


# ============================================================================
# TEMPORARY & CACHE
# ============================================================================
*.tmp
*.temp
.cache/
tmp/


# ============================================================================
# PROJECT ARCHIVES
# ============================================================================
# Old experiments (keep structure, ignore large files)
archive/**/models/*.pkl
archive/**/data/*.csv


# ============================================================================
# REPORTS
# ============================================================================
# Keep final reports, ignore temp/drafts
reports/temp/
reports/draft/


# ============================================================================
# BACKUP FILES
# ============================================================================
*.backup
*.bkp
*_backup/
*.old


# ============================================================================
# EXCEPTIONS (Force-include despite patterns above)
# ============================================================================
# Force-include specific critical files
!data/README.md
!data/metadata/**
!data/production/*/metadata/**
!data/collection_metadata.json
!data/production_dataset_verification.json


# ============================================================================
# PROJECT ORGANIZATION (Added 2025-12-31)
# ============================================================================
# Build logs (moved to logs/builds/)
database_build*.log
build.log

# Build statistics backups (moved to backups/)
backups/

# Keep only latest build stats in root
database_build_stats_*.json
!database_build_stats_20251231_000135.json

# Test results (moved to tests/fixtures/)
test_results_*.csv
